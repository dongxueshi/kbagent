# MySQL 5.7+; create the database and grant the application user access first.
KBAGENT_MYSQL_HOST=127.0.0.1
KBAGENT_MYSQL_PORT=3306
KBAGENT_MYSQL_DATABASE=kbagent
KBAGENT_MYSQL_USER=kbagent
KBAGENT_MYSQL_PASSWORD=replace-with-a-strong-password
# Optional trusted CA for remote MySQL TLS.
# KBAGENT_MYSQL_SSL_CA=/path/to/ca.pem

# MinIO endpoint is host:port (no http:// or path).
KBAGENT_MINIO_ENDPOINT=127.0.0.1:9000
KBAGENT_MINIO_ACCESS_KEY=replace-with-access-key
KBAGENT_MINIO_SECRET_KEY=replace-with-secret-key
KBAGENT_MINIO_BUCKET=kbagent
KBAGENT_MINIO_SECURE=false
KBAGENT_MINIO_REGION=us-east-1
KBAGENT_MINIO_CREATE_BUCKET=true

# Optional model configuration; no model key is needed for retrieval mode.
KBAGENT_API_KEY=
KBAGENT_MODEL=
KBAGENT_BASE_URL=https://api.openai.com/v1
# Each chat / Wiki analysis unit timeout; model requests have a separate timeout.
KBAGENT_AGENT_TIMEOUT=120
KBAGENT_MODEL_TIMEOUT=45
# Whole imported repository: bounded source chunks and hierarchical summary batches.
KBAGENT_WIKI_TASK_TIMEOUT=7200
KBAGENT_WIKI_BATCH_FILES=8
# Preferred summary length; longer valid results may fit the context-derived hard limit.
KBAGENT_WIKI_SUMMARY_CHARS=2000
KBAGENT_WIKI_MAX_STEPS=80
KBAGENT_WIKI_SOURCE_CHARS=24000
# Legacy overview-only research file budget; does not limit full Wiki coverage.
KBAGENT_WIKI_MAX_FILES=12
KBAGENT_PORT=8000

# Only for optional local Docker services; never used by the application.
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
KBAGENT_MINIO_PORT=9000
KBAGENT_MINIO_CONSOLE_PORT=9001
# A separate disposable database, never the real application database.
KBAGENT_TEST_MYSQL_DATABASE=kbagent_test

# Optional code Wiki: all remote repository URLs must be under this GitLab origin/base path.
KBAGENT_GITLAB_URL=
KBAGENT_GITLAB_USERNAME=oauth2
# A read_repository-only personal/project access token. Never put it in a repository URL.
KBAGENT_GITLAB_TOKEN=
# Optional trusted CA for a self-hosted GitLab; TLS verification stays enabled.
# KBAGENT_GITLAB_SSL_CA=/path/to/gitlab-ca.pem
# Already-cloned directories on the SERVER, scoped to an explicit allowlist (JSON array).
KBAGENT_REPOSITORY_LOCAL_ROOTS=[]
# Example: KBAGENT_REPOSITORY_LOCAL_ROOTS=["/srv/repos","/Users/me/projects"]
KBAGENT_REPOSITORY_GIT_TIMEOUT=120
KBAGENT_REPOSITORY_MAX_FILES=500
KBAGENT_REPOSITORY_MAX_FILE_BYTES=200000
KBAGENT_REPOSITORY_MAX_TOTAL_BYTES=10000000
